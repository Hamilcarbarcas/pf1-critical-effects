<form class="dedicated-healing-form">
  <p class="dh-incoming">{{totalHealing}} HP incoming</p>
  <table class="dh-table">
    <thead>
      <tr>
        <th class="dh-col-name">Condition</th>
        <th class="dh-col-progress">Progress</th>
        <th class="dh-col-input">Allocate</th>
      </tr>
    </thead>
    <tbody>
      {{#each participants}}
      <tr class="{{#if blocked}}dh-blocked{{/if}}{{#if clearOnHeal}} dh-on-heal{{/if}}">
        <td class="dh-name">{{name}}</td>
        <td class="dh-progress">
          {{~#if clearOnHeal}}&mdash;{{else}}{{received}} / {{required}} HP{{/if~}}
        </td>
        <td>
          {{#if blocked}}
          <span class="dh-blocked-reason">{{blockedReason}}</span>
          {{else if clearOnHeal}}
          {{!-- No input: it absorbs nothing. It goes when hit points do, so it is here for
                warning rather than for allocation. --}}
          <span class="dh-on-heal-note">clears on healing</span>
          {{else}}
          <input type="number" class="dh-alloc-input"
                 data-participant-id="{{id}}"
                 min="0" max="{{remaining}}"
                 value="0">
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <div class="dh-footer">
    <span>Missing HP: <strong>{{maxHpHealable}}</strong></span>
  </div>
</form>
