{{!-- Standalone manual resolver (DESIGN.md §7.5). Feeds resolve/context.mjs by hand, then opens
      the same resolution dialog the automated flow uses, already past its Trigger stage.

      Source and target are both here because the resolution needs both: the source is who gets
      asked to roll (the standalone stand-in for the attacking player), and the target is whose
      body the location chart belongs to.

      Anatomy and damage type are deliberately NOT asked for: the resolution dialog asks for both
      at its Location stage regardless, and asking twice invites the two answers to disagree.
      Anatomy comes off the chosen target; damage type is chosen there. --}}
<div class="ce-body">

  <div class="ce-fields">
    <label class="ce-field">
      <span class="ce-field-label">Source</span>
      <select name="sourceId" {{#unless hasTokens}}disabled{{/unless}}>
        <option value="">— none —</option>
        {{#each tokens}}<option value="{{id}}" {{#if (eq id ../seed.sourceId)}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </label>
    <label class="ce-field">
      <span class="ce-field-label">Target</span>
      {{#if hasTokens}}
        <select name="targetId">
          {{#each tokens}}<option value="{{id}}" {{#if (eq id ../seed.targetId)}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      {{else}}
        <select name="targetId" disabled><option value="">no tokens on this scene</option></select>
      {{/if}}
    </label>
  </div>
  <span class="ce-hint">The source's player is asked to roll the hit location and the Critical Power; with
  no source the GM rolls both. Creature type comes from the target, and the resolution lets you correct it.</span>

  <div class="ce-fields">
    <label class="ce-field">
      <span class="ce-field-label">Critical multiplier</span>
      <select name="critMult">
        {{#each critMults}}<option value="{{this}}" {{#if (eq this ../seed.critMult)}}selected{{/if}}>&times;{{this}}</option>{{/each}}
      </select>
    </label>
    <label class="ce-field">
      <span class="ce-field-label">Weapon class</span>
      <select name="weaponClass">
        {{#each weaponClasses}}<option value="{{key}}" {{#if (eq key ../seed.weaponClass)}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>

  <div class="ce-fields">
    <label class="ce-field">
      {{!-- Labelled "source" to match the field above; the name stays `attackerSize`, which is
            what resolve/context.mjs and resolve/power.mjs call it. --}}
      <span class="ce-field-label">Source size</span>
      <select name="attackerSize">
        {{#each sizes}}<option value="{{index}}" {{#if (eq index ../seed.attackerSize)}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label class="ce-field">
      <span class="ce-field-label">Target size</span>
      <select name="targetSize">
        {{#each sizes}}<option value="{{index}}" {{#if (eq index ../seed.targetSize)}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>
  <span class="ce-hint">One step of difference is worth &plusmn;1 on the Critical Power total.</span>

  {{!-- What the inputs currently buy, before committing to them. Same readout the resolution
        dialog opens with, so the number doesn't appear to change on the way through. --}}
  <div class="ce-readout">
    <div class="ce-line">
      <span class="ce-line-label">Power</span>
      <span class="ce-line-value">
        <strong class="ce-accent">{{preview.grade}}</strong>
        <span class="ce-mono">{{previewFormula}}</span>
        {{#unless (eq preview.base preview.grade)}}<em class="ce-muted">from {{preview.base}}</em>{{/unless}}
      </span>
    </div>
  </div>

  <div class="ce-stage-controls ce-submit">
    <button type="submit" class="ce-btn ce-primary">
      <i class="fa-solid fa-burst"></i> Open Resolution
    </button>
  </div>

</div>
